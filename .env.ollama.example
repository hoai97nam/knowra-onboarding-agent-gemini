# Example .env configuration for Ollama provider

# ===========================
# OLLAMA CONFIGURATION (LOCAL LLM)
# ===========================
PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.7

# For embedding models (optional)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===========================
# APPLICATION SETTINGS
# ===========================
APP_NAME=Knowledge Chatbot API
DEBUG=False
HOST=0.0.0.0
PORT=8000

# CORS Origins (adjust for your frontend)
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ===========================
# RAG CONFIGURATION
# ===========================
DATA_DIR=../data/raw
VECTOR_STORE_DIR=./backend/.vectorstore
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=5
MEMORY_WINDOW=10
AUTO_REBUILD_ENABLED=True

# ===========================
# DATABASE (MongoDB - Optional)
# ===========================
MONGODB_URL=
MONGODB_DB_NAME=knowra_chatbot

# ===========================
# REDIS (Optional, for session persistence)
# ===========================
REDIS_URL=

# ===========================
# NOTE: Keep OpenAI/Gemini keys empty when using Ollama
# ===========================
# OPENAI_API_KEY=
# GEMINI_API_KEY=
